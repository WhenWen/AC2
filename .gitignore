# Experiment outputs — keep each experiment's runner.py / submit.sbatch tracked,
# ignore everything a run generates (checkpoints, rollouts, metrics, manifest snapshot).
experiments/*/run_data/
experiments/*/manifest/
# Dashboard artifacts (ac2.viz): per-experiment analysis/ + top-level browse folder.
experiments/*/analysis/
visual_results/

# Generated manifest output from tests/test_utils.py (not a fixture).
tests/test_manifest/

# We don't use the uv project/lock workflow — deps come from install.sh, and the
# version record is `uv pip freeze` captured per-run in the manifest.
uv.lock

# --- run outputs, artifacts & ephemeral state (never commit; any experiment layout) ---
run_data*/
experiments/**/wandb/
wandb/
experiments/**/rollouts/
experiments/**/val_rollouts/
experiments/**/checkpoints/
experiments/**/step_cache/
experiments/**/.dash_*/
experiments/**/alloc_*.info
experiments/**/*.out
experiments/**/*.err
sp-*.out
sp-*.err
*.orig
*.rej

# attach counters
experiments/**/run_*.attempts

# --- generated training data: NEVER commit (2026-07-26 and 2026-07-27 incidents) ---
# This repo's index is shared by several concurrent experiment threads. Twice now a
# `git add -A` in one thread left ~1.6GB of generated data staged, and the next thread's
# bare `git commit` swallowed it -- five parquets of 173-198MB each, over GitHub's 100MB
# limit, so EVERY push was rejected by the pre-receive hook and the dashboard stopped
# syncing for hours until the history was rewritten. These are all regenerable artifacts
# (SFT datasets, Q-seed shards, replay seeds); if one ever needs versioning it wants Git
# LFS, not a plain commit.
#   Companion fix: dash_heartbeat.sh commits with `git commit -o "$PDF"` so it can only
#   ever take the PDF regardless of what else is staged. Prefer `-o <path>` for any
#   scripted commit here.
experiments/**/data/*.parquet
experiments/**/train_data/
experiments/**/val_data/
experiments/**/replay_seed*/
experiments/**/q_seed*/

# per-experiment runtime state (launch latches, step timers, daemon scratch) -- these are
# machine-local bookkeeping, not source, and were swept into the same bad commits
experiments/**/.autolaunch*.done
experiments/**/.bootstrap*.done
experiments/**/.warm.stop
experiments/**/.step_secs
experiments/**/.dash_heartbeat.*
experiments/**/.dash_difficulty_phat.json
experiments/**/.gpu_keepalive.pid
experiments/**/*.bak_*

# Superseded runs are MOVED here rather than deleted (see each legacy/*/README.md).
# They carry the full run output -- checkpoints, rollouts, q_wave dumps and the delta
# logs, the last of which are single files well over GitHub's 100MB limit -- so the
# whole tree is ignored. The README is force-added so the rationale stays versioned.
experiments/*/legacy/
experiments/*/[0-9]*_metrics_extract.json

