# Site configuration for the experiment launch scripts. Copy this file to .env (gitignored) and
# fill in your values. The scripts under experiments/ load .env automatically, and
# scripts/sbatch_env.sh substitutes these values into the #SBATCH headers before submitting.
#
# Every experiment uses the same three entry points (see README.md, "Running an experiment"):
#   submit_<N>node.sbatch   SLURM allocation that starts Ray on N nodes x 8 GPUs
#   run_attach.sh           preflight checks + training driver, started inside that allocation
#   setup.sh                per-node runtime environment sourced by both

# ---- paths -----------------------------------------------------------------------------------
AC2_REPO=/path/to/AC2                  # this repository, checked out on a filesystem all nodes see
AC2_SCRATCH=/path/to/scratch           # writable shared scratch: .cache/, hf_home/, logs/
AC2_DATA_DIR=/path/to/data/fineproofs  # FineProofs-RL parquet files, val_map.json, rubric_map.json
AC2_HF_HOME=/path/to/scratch/hf_home   # Hugging Face home; the judge and policy weights must be cached here
AC2_HF_HUB_CACHE=                      # optional: separate (e.g. read-only) hub cache; default $AC2_HF_HOME/hub
AC2_CUDA_COMPAT=                       # optional: CUDA 12.9 forward-compatibility libs for drivers older than 575

# ---- SLURM -----------------------------------------------------------------------------------
# An empty value drops that #SBATCH line (scripts/sbatch_env.sh).
AC2_ACCOUNT=your-slurm-account
AC2_PARTITION=your-partition
AC2_QOS=
AC2_CPUS_PER_NODE=32                   # --cpus-per-task of the one task per node
AC2_MEM_PER_NODE=0                     # --mem per node (0 = all of the node's memory)
AC2_TIME_LIMIT=12:00:00                # --time; runs resume from their last checkpoint on resubmission
AC2_MAIL_USER=                         # SLURM job e-mail

# ---- logging ---------------------------------------------------------------------------------
AC2_WANDB_ENTITY=your-wandb-entity
AC2_WANDB_MODE=offline                 # online if the compute nodes can reach wandb.ai
